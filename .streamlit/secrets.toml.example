# Copy this into Streamlit Cloud → your app → Settings → Secrets
# (or, to run on your computer, save it as .streamlit/secrets.toml — never commit that file).

# Step 2 (Google AI Studio): your Gemini API key
GEMINI_API_KEY = "paste-your-gemini-key-here"

# Step 3 (Supabase → Project Settings → API Keys): Project URL and SECRET key
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "paste-your-supabase-secret-key-here"

# Recommended: a password, so only you can use your app (and your free Gemini quota)
APP_PASSWORD = "choose-a-password"

# Optional
GEMINI_MODEL = "gemini-3.8-flash"
LEARNER_ID = "me"
