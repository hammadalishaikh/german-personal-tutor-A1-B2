# CLOUD MODE: copy this into Streamlit Cloud → your app → Settings → Secrets.
# (Laptop/local mode doesn't need this file: start_local.bat asks for your Gemini key once.)

# Google AI Studio: your Gemini API key
GEMINI_API_KEY = "paste-your-gemini-key-here"

# Supabase → Project Settings → API Keys: Project URL and SECRET key.
# When these are set, the app saves to Supabase; without them it saves to the local data/ folder.
SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "paste-your-supabase-secret-key-here"

# Recommended for the cloud: a password, so only you can use your app (and your free Gemini quota)
APP_PASSWORD = "choose-a-password"

# Optional
GEMINI_MODEL = "gemini-3.8-flash"
LEARNER_ID = "me"
